{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "(gdb) Launch PriceCalculator",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/PriceCalculator",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ''",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable confirmations",
                    "text": "set confirm off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build PriceCalculator",
            "miDebuggerPath": "${workspaceFolder}/gdb_wrapper.sh",
            "miDebuggerArgs": "-ex 'set debuginfod enabled off' -ex 'set debuginfod urls \"\"'",
            "logging": {
                "engineLogging": true
            }
        },
        {
            "name": "(gdb) Launch Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/run_tests",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ''",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable confirmations",
                    "text": "set confirm off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build and Run Tests",
            "miDebuggerPath": "${workspaceFolder}/gdb_wrapper.sh",
            "miDebuggerArgs": "-ex 'set debuginfod enabled off' -ex 'set debuginfod urls \"\"'",
            "logging": {
                "engineLogging": true
            }
        }
    ]
}